{
  "name": "@chistara/iran-legal-calculators",
  "version": "0.1.0",
  "description": "Iranian official holidays, working days and statutory deadlines (Jalali calendar) — vetted official calendar data, Umm al-Qura projection with honest caveats, and the counting rules of Iranian procedure law.",
  "keywords": [
    "iran",
    "jalali",
    "persian",
    "holidays",
    "legal",
    "deadline",
    "working-days",
    "hijri",
    "shamsi",
    "calendar"
  ],
  "homepage": "https://github.com/Chistara/iran-legal-calculators",
  "bugs": {
    "url": "https://github.com/Chistara/iran-legal-calculators/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chistara/iran-legal-calculators.git"
  },
  "license": "MIT",
  "author": "Chistara (hoghogh.ai)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "jalaali-js": "^2.0.1"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
